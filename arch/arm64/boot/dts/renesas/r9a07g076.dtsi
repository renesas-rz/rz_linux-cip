			clocks = <&cpg CPG_MOD R9A07G076_PCIE_CLK>;
			power-domains = <&cpg>;
			resets = <&cpg R9A07G076_PCIE_RST>;
			ranges = <0x02000000 0x0 0xA0000000 0x4 0x00000000 0x0 0x10000000>;
			dma-ranges = <0x02000000 0x0 0xC4000000 0x0 0xC4000000 0x0 0x3C000000>,
				     <0x42000000 0x2 0x40000000 0x2 0x40000000 0x0 0x40000000>;
			interrupts = <GIC_SPI 612 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 616 IRQ_TYPE_LEVEL_HIGH>;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0>;
			interrupt-map = <0 0 0 0 &gic GIC_SPI 612 IRQ_TYPE_LEVEL_HIGH>;
			bus-range = <0x0 0xff>;
			linux,pci-domain = <0x0>;
			#address-cells = <3>;
			#size-cells = <2>;
			pcie,channel = <0>;
			status = "disabled";
		};

