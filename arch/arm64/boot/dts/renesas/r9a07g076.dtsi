			      <0 0x80297000 0 0x50>;
			interrupts = <GIC_SPI 628 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD R9A07G076_NANDC_CLK>,
				 <&cpg CPG_CORE R9A07G076_PCLKAM>,
				 <&cpg CPG_CORE R9A07G076_PCLKAL>;
			clock-names = "nf_clk", "sysclk", "busclk";
			resets = <&cpg R9A07G076_NANDC_SYSTEM_RST>,
				 <&cpg R9A07G076_NANDC_SLAVE_RST>,
				 <&cpg R9A07G076_NANDC_PROTECT_RST>;
			reset-names = "rst_sys", "rst_slave", "rst_prot";
			power-domains = <&cpg>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gpt03_1: gpt03_1@90101100 {
			compatible = "renesas,gpt-r9a07g076";
			reg =   <0 0x90101100 0 0x100>,
				<0 0x80290000 0 0x0c>;
			reg-names = "base1", "base2";
			#pwm-cells = <2>;
			interrupts = <GIC_SPI 709 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 710 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 177 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 178 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 179 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 180 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 181 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "adtrga", "adtrgb", "int0", "int1",
					  "int2", "int3", "int4";
			clocks = <&cpg CPG_MOD R9A07G076_GPT3_CLK>;
			power-domains = <&cpg>;
			renesas,syscon-perierr-error = <&icu_ns_int>,
						       <&icu_s_int>;
			status = "disabled";
		};

		poeg0_a: poega@90019000 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x90019000 0 0x400>;
			interrupts = <GIC_SPI 337 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKH>;
			power-domains = <&cpg>;
			llpp,disable-by-DSMIF-error;
			status = "disabled";
		};

		poeg0_b: poegb@90019400 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x90019400 0 0x400>;
			interrupts = <GIC_SPI 338 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKH>;
			power-domains = <&cpg>;
			llpp,disable-by-DSMIF-error;
			status = "disabled";
		};

		poeg0_c: poegc@90019800 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x90019800 0 0x400>;
			interrupts = <GIC_SPI 339 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKH>;
			power-domains = <&cpg>;
			llpp,disable-by-DSMIF-error;
			status = "disabled";
		};

		poeg0_d: poegd@90019c00 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x90019c00 0 0x400>;
			interrupts = <GIC_SPI 340 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKH>;
			power-domains = <&cpg>;
			llpp,disable-by-DSMIF-error;
			status = "disabled";
		};

		poeg1_a: poega@80087000 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x80087000 0 0x400>;
			interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg1_b: poegb@80087400 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x80087400 0 0x400>;
			interrupts = <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg1_c: poegc@80087800 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x080087800 0 0x400>;
			interrupts = <GIC_SPI 343 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg1_d: poegd@080087c00 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x080087c00 0 0x400>;
			interrupts = <GIC_SPI 344 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg2_a: poega@8100a000 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x8100a000 0 0x400>;
			interrupts = <GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg2_b: poegb@8100a400 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x8100a400 0 0x400>;
			interrupts = <GIC_SPI 346 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg2_c: poegc@8100a800 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x8100a800 0 0x400>;
			interrupts = <GIC_SPI 347 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poeg2_d: poegd@08100ac00 {
			compatible = "renesas,poeg-r9a07g076";
			reg = <0 0x8100ac00 0 0x400>;
			interrupts = <GIC_SPI 348 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_CORE R9A07G076_PCLKL>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		hpsw: hpsw@80170000 {
			compatible = "renesas,rzt2n-hpsw";
			reg = <0 0x80170000 0 0x50000>;
			clocks = <&cpg CPG_MOD R9A07G076_HPSW_CLK>;
			resets = <&cpg R9A07G076_HPSW_RST>;
			power-domains = <&cpg>;
			status = "disabled";

			ethernet-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				hpsw_portA: port@0 {
					reg = <0>;
					status = "disabled";
				};

				hpsw_portB: port@1 {
					reg = <1>;
					status = "disabled";
				};

				hpsw_portC: port@2 {
					reg = <2>;
					ethernet = <&gmac0>;
					phy-mode = "internal";
					status = "disabled";
					fixed-link {
						speed = <1000>;
						full-duplex;
					};
				};
			};
		};

		edac: edac@80300000 {
			compatible = "renesas,r9a07g076-edac";
			reg = <0 0x80300000 0 0x10000>;
			interrupts = <GIC_SPI 629 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "ecc_irq";
		};
	};

	thermal-zones {
		emergency {
			polling-delay = <1000>;
			on-temperature = <110000>;
			off-temperature = <95000>;
			target_cpus = <&cpu1>;
			status = "disabled";
		};

		sensor_thermal: sensor-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&tsu 0>;

			trips {
				sensor_crit: sensor-crit {
					temperature = <123000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts-extended = <&gic GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 12 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "sec-phys", "phys", "virt", "hyp-phys", "hyp-virt";
	};
};
