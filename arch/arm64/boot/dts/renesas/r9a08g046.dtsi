		poega: poega@10048800 {
			compatible = "renesas,poeg-r9a08g046",
				     "renesas,poeg-r9a07g044";
			reg = <0 0x10048800 0 0x04>;
			interrupts = <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD R9A08G046_POEG_A_CLKP>;
			resets = <&cpg R9A08G046_POEG_A_RST>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poegb: poegb@10048C00 {
			compatible = "renesas,poeg-r9a08g046",
				     "renesas,poeg-r9a07g044";
			reg = <0 0x10048C00 0 0x04>;
			interrupts = <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD R9A08G046_POEG_B_CLKP>;
			resets = <&cpg R9A08G046_POEG_B_RST>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poegc: poegc@10049000 {
			compatible = "renesas,poeg-r9a08g046",
				     "renesas,poeg-r9a07g044";
			reg = <0 0x10049000 0 0x04>;
			interrupts = <GIC_SPI 303 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD R9A08G046_POEG_C_CLKP>;
			resets = <&cpg R9A08G046_POEG_C_RST>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		poegd: poegd@10049400 {
			compatible = "renesas,poeg-r9a08g046",
				     "renesas,poeg-r9a07g044";
			reg = <0 0x10049400 0 0x04>;
			interrupts = <GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD R9A08G046_POEG_D_CLKP>;
			resets = <&cpg R9A08G046_POEG_D_RST>;
			power-domains = <&cpg>;
			status = "disabled";
		};

		cru: video0@10830000 {
			compatible = "renesas,rzg3l-cru";
			reg = <0 0x10830000 0 0x400>;
			clocks = <&cpg CPG_MOD R9A08G046_CRU_VCLK>,
				 <&cpg CPG_MOD R9A08G046_CRU_PCLK>,
				 <&cpg CPG_MOD R9A08G046_CRU_ACLK>;
			clock-names = "video", "pclk", "aclk";
			interrupts = <GIC_SPI 196 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&cpg R9A08G046_CRU_PRESETN>,
				 <&cpg R9A08G046_CRU_ARESETN>;
			reset-names = "presetn", "aresetn";
			power-domains = <&cpg>;
			channel,id = <0>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;

					cru_to_csi2: endpoint {
						remote-endpoint = <&csi2_to_cru>;
					};
				};
			};
		};

		csi2: csi2@10830400 {
			compatible = "renesas,rzg3l-csi2";
			reg = <0 0x10830400 0 0xc00>;
			interrupts = <GIC_SPI 195 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cpg CPG_MOD R9A08G046_CRU_VCLK>,
				 <&cpg CPG_MOD R9A08G046_CRU_SYSCLK>,
				 <&cpg CPG_MOD R9A08G046_CRU_PCLK>;
			clock-names = "video", "system";
			resets = <&cpg R9A08G046_CRU_CMN_RSTB>,
				 <&cpg R9A08G046_CRU_PRESETN>;
			reset-names = "cmn-rstb", "presetn";
			power-domains = <&cpg>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;

					csi2_to_cru: endpoint {
						remote-endpoint = <&cru_to_csi2>;
					};
				};
			};
		};
		
		mtu3: timer@10001200 {
			compatible = "renesas,r9a08g046-mtu3",
				     "renesas,rz-mtu3";
			reg = <0 0x10001200 0 0xb00>;
			#pwm-cells = <2>;
